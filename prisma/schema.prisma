generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Usuario {
  id               Int @id @default(autoincrement())
  nombre           String
  email            String            @unique
  passwordHash     String
  activo           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Marca {
  id        Int @id @default(autoincrement())
  nombre    String     @unique
  activa    Boolean    @default(true)
  productos Producto[]
}

model Categoria {
  id        Int @id @default(autoincrement())
  nombre    String     @unique
  activa    Boolean    @default(true)
  productos Producto[]
}

enum MonedaPrecio {
  ARS
  USD
}

model Producto {
  id                Int @id @default(autoincrement())
  nombre            String
  codigoBarras      String? @unique
  ubicacionDeposito String?
  fotoUrl           String?
  contenidoMl       Int?

  marca       Marca?     @relation(fields: [marcaId], references: [id])
  marcaId     Int?
  categoria   Categoria? @relation(fields: [categoriaId], references: [id])
  categoriaId Int?

  stockActual Int     @default(0)
  stockMinimo Int     @default(0)
  destacado   Boolean @default(false)

  // Precios — moneda configurable por producto (no todos se cargan en USD)
  monedaPrecio    MonedaPrecio @default(USD)
  precioCosto     Float
  precioVenta     Float // precio minorista
  margenMinorista Float? // % informativo, no siempre se persiste calculado
  precioMayorista Float?
  margenMayorista Float?
  precioOferta    Float?

  // Decants
  seVendePorDecant   Boolean @default(false)
  overrideDecant5ml  Float? // si está cargado, pisa el cálculo de la fórmula global
  overrideDecant10ml Float?

  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  itemsVenta       ItemVenta[]
  itemsCompra      ItemCompra[]
  historialPrecios HistorialPrecio[]

  @@index([nombre])
  @@index([codigoBarras])
}

enum CampoPrecio {
  COSTO
  MINORISTA
  MAYORISTA
  OVERRIDE_5ML
  OVERRIDE_10ML
}

enum OrigenCambioPrecio {
  MANUAL
  RECALCULO_DECANT
  ACTUALIZACION_MASIVA
  COMPRA_CONFIRMADA
}

model HistorialPrecio {
  id            Int @id @default(autoincrement())
  producto      Producto           @relation(fields: [productoId], references: [id])
  productoId    Int
  campo         CampoPrecio
  valorAnterior Float?
  valorNuevo    Float
  origen        OrigenCambioPrecio
  detalle       String?
  fecha         DateTime           @default(now())

  @@index([productoId])
  @@index([fecha])
}

model Cliente {
  id          Int @id @default(autoincrement())
  nombre      String
  apellido    String?
  telefono    String?
  email       String?
  direccion   String?
  localidad   String?
  esMayorista Boolean  @default(false)
  createdAt   DateTime @default(now())

  ventas       Venta[]
  presupuestos Presupuesto[]

  @@index([nombre])
  @@index([apellido])
}

enum EstadoPago {
  PAGADA
  A_CUENTA
  ANULADA
  CANCELADA
}

enum Presentacion {
  FRASCO
  DECANT_5ML
  DECANT_10ML
}

enum TipoPrecioVenta {
  MINORISTA
  MAYORISTA
}

model Venta {
  id         Int @id @default(autoincrement())
  cliente   Cliente? @relation(fields: [clienteId], references: [id])
  clienteId Int?

  presupuesto   Presupuesto? @relation(fields: [presupuestoId], references: [id])
  presupuestoId Int?         @unique

  fecha           DateTime @default(now())
  cotizacionUsada Float

  descuentoMonto      Float?
  descuentoPorcentaje Float?

  totalUSD    Float
  totalARS    Float
  montoPagado Float @default(0)

  estadoPago EstadoPago @default(PAGADA)

  armado   Boolean @default(false)
  enviado  Boolean @default(false)
  retirado Boolean @default(false)
  impreso  Boolean @default(false)

  items           ItemVenta[]
  pagos           PagoVenta[]
  movimientosCaja MovimientoCaja[]

  @@index([clienteId])
  @@index([fecha])
  @@index([estadoPago])
  @@index([estadoPago, fecha])   // cubre filtro por estado + orden por fecha juntos
  @@index([retirado, estadoPago]) // la pantalla de Pedidos siempre filtra por estos dos
  @@index([armado])
  @@index([enviado])
}

model ItemVenta {
  id          Int @id @default(autoincrement())
  venta   Venta  @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  ventaId Int

  // Nullable: contempla el botón "Varios / Muestra" (ítem libre sin producto de catálogo)
  producto         Producto? @relation(fields: [productoId], references: [id])
  productoId       Int?
  descripcionLibre String?

  presentacion       Presentacion @default(FRASCO)
  abrioFrascoCerrado Boolean      @default(false) // true si un decant se vendió abriendo stock de frasco

  tipoPrecio        TipoPrecioVenta @default(MINORISTA)
  cantidad          Int
  precioUnitarioUSD Float

  @@index([ventaId])
  @@index([productoId])
}

model PagoVenta {
  id       Int @id @default(autoincrement())
  venta    Venta  @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  ventaId  Int
  cuenta   Cuenta @relation(fields: [cuentaId], references: [id])
  cuentaId Int
  monto    Float
  fecha    DateTime @default(now())

  @@index([ventaId])
}

enum EstadoPresupuesto {
  BORRADOR
  VENCIDO
  CONVERTIDO
}

model Presupuesto {
  id        Int @id @default(autoincrement())
  cliente   Cliente? @relation(fields: [clienteId], references: [id])
  clienteId Int?

  fecha            DateTime @default(now())
  vigenciaDias     Int      @default(15)
  fechaVencimiento DateTime

  observaciones       String?
  descuentoMonto      Float?
  descuentoPorcentaje Float?
  total               Float

  estado EstadoPresupuesto @default(BORRADOR)

  items           PresupuestoItem[]
  ventaConvertida Venta?
}

model PresupuestoItem {
  id          Int @id @default(autoincrement())
  presupuesto    Presupuesto     @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)
  presupuestoId  Int
  productoId     Int?
  descripcion    String
  presentacion   Presentacion    @default(FRASCO)
  tipoPrecio     TipoPrecioVenta @default(MINORISTA)
  cantidad       Int
  precioUnitario Float

  @@index([presupuestoId])
}

model Proveedor {
  id              Int @id @default(autoincrement())
  nombre          String
  personaContacto String?
  telefono        String?
  email           String?
  deudaInicial    Float    @default(0)
  notas           String?
  createdAt       DateTime @default(now())

  compras Compra[]
  gastos  Gasto[]

  @@index([nombre])
}

model Compra {
  id          Int @id @default(autoincrement())
  proveedor   Proveedor? @relation(fields: [proveedorId], references: [id])
  proveedorId Int?

  cuenta   Cuenta @relation(fields: [cuentaId], references: [id])
  cuentaId Int

  totalUSD        Float
  totalARS        Float?
  cotizacionUsada Float?

  confirmada Boolean  @default(false)
  pagada     Boolean  @default(false)
  recibida   Boolean  @default(false)
  cancelada  Boolean  @default(false)
  fecha      DateTime @default(now())

  items           ItemCompra[]
  movimientosCaja MovimientoCaja[]

  @@index([proveedorId])
  @@index([cuentaId])
  @@index([fecha])
}

model ItemCompra {
  id               Int @id @default(autoincrement())
  compra           Compra   @relation(fields: [compraId], references: [id], onDelete: Cascade)
  compraId         Int
  producto         Producto @relation(fields: [productoId], references: [id])
  productoId       Int
  cantidad         Int
  costoUnitarioUSD Float

  @@index([compraId])
  @@index([productoId])
}

enum TipoCuenta {
  EFECTIVO_ARS
  EFECTIVO_USD
  BANCO_ARS
  BANCO_USD
}

model Cuenta {
  id       Int @id @default(autoincrement())
  nombre   String
  tipo     TipoCuenta
  titular  String?
  banco    String?
  alias    String?
  cbu      String?
  color    String?
  favorita Boolean    @default(false)

  saldoInicial          Float  @default(0)
  saldoActual           Float  @default(0)
  limiteMensualIngresos Float?

  activa    Boolean  @default(true)
  createdAt DateTime @default(now())

  movimientos MovimientoCaja[]
  pagosVenta  PagoVenta[]
  compras Compra[]

  @@index([nombre])
}

enum TipoMovimientoCaja {
  INGRESO
  EGRESO
}

enum ConceptoMovimientoCaja {
  VENTA_COBRADA
  PAGO_DEUDA_CLIENTE
  PAGO_A_PROVEEDOR
  GASTO
  OTRO
}

model MovimientoCaja {
  id              Int @id @default(autoincrement())
  cuenta          Cuenta                 @relation(fields: [cuentaId], references: [id])
  cuentaId        Int
  tipo            TipoMovimientoCaja
  concepto        ConceptoMovimientoCaja
  monto           Float
  saldoResultante Float
  fecha           DateTime               @default(now())

  venta    Venta?  @relation(fields: [ventaId], references: [id])
  ventaId  Int?
  gasto    Gasto?  @relation(fields: [gastoId], references: [id])
  gastoId  Int?
  compra   Compra? @relation(fields: [compraId], references: [id])
  compraId Int?

  @@index([cuentaId])
  @@index([fecha])
}

model CategoriaGasto {
  id          Int @id @default(autoincrement())
  nombre String  @unique
  gastos Gasto[]
}

enum EstadoPagoGasto {
  PENDIENTE
  PAGADO
}

model Gasto {
  id            Int @id @default(autoincrement())
  monto         Float
  concepto      String
  categoria     CategoriaGasto? @relation(fields: [categoriaId], references: [id])
  categoriaId   Int?
  proveedor     Proveedor?      @relation(fields: [proveedorId], references: [id])
  proveedorId   Int?
  observaciones String?
  estadoPago    EstadoPagoGasto @default(PENDIENTE)
  fecha         DateTime        @default(now())

  movimientosCaja MovimientoCaja[]

  @@index([fecha])
  @@index([categoriaId])
}

model Configuracion {
  id              String  @id @default("singleton")
  nombreNegocio   String
  logoUrl         String?
  telefono        String?
  email           String?
  direccion       String?
  remitenteNombre String?
  remitenteDni    String?

  cotizacionUSD Float @default(1000)

  // Compras
  costoPromedioPonderado Boolean @default(true)

  // Productos
  margenGananciaGlobal   Boolean @default(false)
  margenMinoristaDefault Float?
  margenMayoristaDefault Float?

  // Fórmula de decants
  costoEnvaseDecantARS      Float?
  multiplicadorInsumoDecant Float?
  divisorFrascoDecant       Float?  @default(9)
  offsetDecant5mlARS        Float?  @default(200)

  updatedAt DateTime @updatedAt
}
